+class MissingPygmentsError(ImportError):
+    """Raised when a Pygments-dependent feature is used without Pygments installed.
+
+    Rich's built-in ``ansi_light`` / ``ansi_dark`` themes work without Pygments.
+    Everything else (Pygments themes, lexer based highlighting, lexer guessing)
+    requires the optional ``pygments`` dependency.
+    """
+
+
+def _require_pygments(feature: str) -> None:
+    """Raise a helpful error if Pygments is not importable."""
+    if not _pygments_available():
+        raise MissingPygmentsError(
+            f"{feature} requires the optional 'pygments' dependency.\n"
+            "Install it with:  pip install 'rich[syntax]'\n"
+            "Or use one of the built-in themes ('ansi_light' / 'ansi_dark'), which "
+            "work without Pygments."
+        )
+
+
+@lru_cache(maxsize=1)
+def _pygments_available() -> bool:
+    """Whether the optional Pygments dependency can be imported."""
+    try:
+        import pygments  # noqa: F401
+    except ImportError:  # pragma: no cover - depends on install environment
+        return False
+    return True
+
+
+def _warn_pygments_fallback(theme: str) -> None:
+    """Warn once when a Pygments theme is unavailable and we fall back."""
+    global _warned_about_pygments
+    if _warned_about_pygments:
+        return
+    _warned_about_pygments = True
+    warnings.warn(
+        f"Syntax theme {theme!r} requires the optional 'pygments' dependency, "
+        "which is not installed. Falling back to the built-in 'ansi_dark' theme. "
+        "Install Pygments for full theme support:  pip install 'rich[syntax]'",
+        UserWarning,
+        stacklevel=3,
+    )
+
+
+_warned_about_pygments = False
 
 
